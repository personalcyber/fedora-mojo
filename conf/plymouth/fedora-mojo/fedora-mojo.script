# Fedora Mojo boot splash. Dark brand-gradient background, a centered
# pulsing spark mark (logo-mark.png, transparent background), and the
# brand wordmark underneath so the boot sequence clearly identifies
# this as Fedora Mojo rather than stock Fedora.

Window.SetBackgroundTopColor(0.106, 0.165, 0.290);    # #1b2a4a
Window.SetBackgroundBottomColor(0.051, 0.082, 0.149); # #0d1526

# logo-mark.png is a 512x512 source asset; scale it relative to the
# actual panel height (capped at 220px) instead of showing it at native
# size, so it doesn't overflow smaller boot-splash resolutions -- this
# fleet includes repurposed Chromebooks with panels well under 1080p.
logo.target_height = Window.GetHeight() * 0.22;
if (logo.target_height > 220) logo.target_height = 220;
logo.image = Image("logo-mark.png").Scale(logo.target_height, logo.target_height);
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 40);
logo.sprite.SetZ(10);

label.image = Image.Text("FEDORA MOJO", 0.933, 0.953, 0.984, 1, "Montserrat Bold 28");
label.sprite = Sprite(label.image);
label.sprite.SetX(Window.GetWidth() / 2 - label.image.GetWidth() / 2);
label.sprite.SetY(logo.sprite.GetY() + logo.image.GetHeight() + 28);
label.sprite.SetZ(10);

# Gentle breathing pulse on the mark, not the wordmark, so the brand
# name stays crisp and legible throughout boot.
fun refresh_callback() {
  time = Plymouth.GetTime();
  logo.sprite.SetOpacity(0.78 + 0.22 * Math.Sin(time * 2));
}
Plymouth.SetRefreshFunction(refresh_callback);
